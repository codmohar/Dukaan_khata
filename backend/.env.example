# Database connection string (Supabase PgBouncer pooler URI or local PostgreSQL)
# Example: postgresql+asyncpg://postgres.yourproject:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Or for local docker postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/dukaan
# Or for local SQLite testing: sqlite+aiosqlite:///./dukaan.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dukaan

# Default shop ID (matches the seeded default shop in 001_init_schema.sql)
DEFAULT_SHOP_ID=00000000-0000-0000-0000-000000000001

# LLM Agent Configuration (Gemini Flash via unified LLMProvider interface)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Speech Providers: "gnani" (Prisma v3.0 / Timbre v3.0) or "sarvam" (saarika / bulbul) or "mock"
SPEECH_PROVIDER=sarvam

# Sarvam AI Credentials (default fallback for STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Gnani AI Credentials (Prisma v3.0 STT & Timbre v3.0 TTS)
GNANI_API_KEY=
GNANI_STT_URL=https://api.gnani.ai/v3/speech-to-text
GNANI_TTS_URL=https://api.gnani.ai/v3/text-to-speech

# CORS origins allowed to access the backend API and WebSocket
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
PORT=8000
